{
  "name": "minidayz-plus-desktop",
  "version": "1.2.0",
  "private": true,
  "description": "Desktop Windows build of MiniDayZ Plus.",
  "main": "desktop/main.js",
  "author": "Bohemia Interactive a.s., Altero",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win portable --x64"
  },
  "build": {
    "appId": "com.local.minidayz.plus",
    "productName": "MiniDayZ Plus",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "docs/**/*",
      "package.json"
    ],
    "win": {
      "icon": "docs/icon-256.png",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "MiniDayZ-Plus-${version}-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "electron-winstaller"
    ]
  }
}
